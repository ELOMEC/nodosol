# Server-only — never exposed to the browser
SOLANA_RPC_URL=https://api.devnet.solana.com

# Public — used by action metadata and UI
NEXT_PUBLIC_APP_NAME=nodosol
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USDC_MINT=Gh9ZwEmdLJ8DscKNTkTqPbNwLNNBjuSzaG9Vp2KGtKJr

# Set to a deployed creator wallet to surface live Blink URLs on the
# landing page instead of the <creator-wallet> placeholder. The init
# script (scripts/init-demo.ts) prints this value on completion.
NEXT_PUBLIC_DEMO_CREATOR=
NEXT_PUBLIC_DEMO_PLAN_ID=1
NEXT_PUBLIC_DEMO_EVENT_ID=1

# Comma-separated base58 wallet pubkeys allowed to load /admin.
# Empty/unset = no wallets pass the gate (all visitors get 403 → /).
NEXT_PUBLIC_ADMIN_WALLETS=
